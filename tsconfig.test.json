{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".test-build",
    "rootDir": ".",
    "target": "ES2019",
    "incremental": false,
    "sourceMap": false,
    "declaration": false,
    "types": ["node"]
  },
  "include": ["tests/**/*.ts", "lib/regions.ts", "lib/deals.ts", "lib/seo.ts", "lib/collections.ts", "lib/collection-content.ts", "lib/blog.ts", "lib/moodboards.ts", "lib/aliexpress.ts"],
  "exclude": ["node_modules", ".test-build"]
}
