{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "npx next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/trend-snapshot",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/telegram-daily",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "pages/api/cron/trend-snapshot.ts": {
      "maxDuration": 300
    },
    "pages/api/cron/telegram-daily.ts": {
      "maxDuration": 120
    }
  }
}
